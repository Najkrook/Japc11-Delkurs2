{
  "name": "japc11-delkurs2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-japc11-delkurs2 \"node --test tests/firestore/*.test.ts\""
  },
  "dependencies": {
    "firebase": "^11.4.0",
    "lit-html": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
}
