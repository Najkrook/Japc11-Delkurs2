rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/progress/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && document == 'course'
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 500000
        && request.resource.data.updatedAt is int;
    }

    match /courseRooms/{roomId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.roomId == roomId
        && request.resource.data.roomCode is string
        && request.resource.data.status in ['waiting', 'question', 'reveal', 'finished'];
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
