rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/progress/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && document == 'course'
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 500000
        && request.resource.data.updatedAt is int;
    }

    match /courseRooms/{roomId} {
      function validRoom() {
        return request.resource.data.roomId == roomId
          && request.resource.data.roomCode is string
          && request.resource.data.status in ['waiting', 'question', 'reveal', 'finished']
          && request.resource.data.players is map
          && request.resource.data.roundAnswers is map;
      }
      function ownPlayerShape(player) {
        return player.keys().hasOnly(['uid', 'name', 'avatar', 'score', 'streak', 'correctCount', 'joinedAt'])
          && player.uid == request.auth.uid
          && player.name is string && player.name.size() <= 80
          && player.avatar is string && player.avatar.size() <= 20
          && player.joinedAt is int;
      }
      function ownPlayerChange() {
        return request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid]);
      }
      function joinOrLeaveOrRename() {
        let uid = request.auth.uid;
        let before = resource.data.players;
        let after = request.resource.data.players;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
          && ownPlayerChange()
          && (
            (!(uid in before) && uid in after && resource.data.status == 'waiting'
              && ownPlayerShape(after[uid]) && after[uid].score == 0
              && after[uid].streak == 0 && after[uid].correctCount == 0)
            || (uid in before && !(uid in after))
            || (uid in before && uid in after && ownPlayerShape(after[uid])
              && after[uid].diff(before[uid]).affectedKeys().hasOnly(['name']))
          );
      }
      function answerOwnRound() {
        let uid = request.auth.uid;
        let key = string(resource.data.currentRoundIndex);
        let beforeAnswers = resource.data.roundAnswers.get(key, {});
        let afterAnswers = request.resource.data.roundAnswers[key];
        let answer = afterAnswers[uid];
        let before = resource.data.players[uid];
        let after = request.resource.data.players[uid];
        let question = resource.data.questions[resource.data.currentRoundIndex];
        let roundMs = resource.data.config.roundDurationSeconds * 1000;
        let streakBonus = before.streak >= 3 ? 300 : before.streak * 100;
        return resource.data.status == 'question'
          && request.time.toMillis() < resource.data.roundStartedAt + resource.data.config.roundDurationSeconds * 1000
          && !(uid in beforeAnswers)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'roundAnswers', 'updatedAt'])
          && ownPlayerChange() && ownPlayerShape(after)
          && after.diff(before).affectedKeys().hasOnly(['score', 'streak', 'correctCount'])
          && request.resource.data.roundAnswers.diff(resource.data.roundAnswers).affectedKeys().hasOnly([key])
          && afterAnswers.diff(beforeAnswers).affectedKeys().hasOnly([uid])
          && answer.keys().hasOnly(['choice', 'correct', 'pointsAwarded', 'timeRemainingMs', 'answeredAt'])
          && answer.choice in question.choices
          && answer.correct == (answer.choice == question.answer)
          && answer.pointsAwarded is int
          && answer.pointsAwarded == (answer.correct ? 500 + int(math.round(answer.timeRemainingMs * 500.0 / roundMs)) + streakBonus : 0)
          && answer.answeredAt is int
          && answer.answeredAt >= resource.data.roundStartedAt
          && answer.answeredAt <= request.time.toMillis()
          && answer.timeRemainingMs is int && answer.timeRemainingMs >= 0
          && answer.timeRemainingMs == roundMs - (answer.answeredAt - resource.data.roundStartedAt)
          && after.score == before.score + answer.pointsAwarded
          && after.streak == (answer.correct ? before.streak + 1 : 0)
          && after.correctCount == before.correctCount + (answer.correct ? 1 : 0);
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && validRoom()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.auth.uid in request.resource.data.players;
      allow update: if request.auth != null && validRoom()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.hostUid == request.auth.uid || joinOrLeaveOrRename() || answerOwnRound());
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}
